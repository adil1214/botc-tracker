{
  "manifest_version": 3,
  "name": "BOTC Tracker",
  "version": "1.0.0",
  "description": "Track nominators, voters & private-chat callers in live Blood on the Clocktower games. Homework helper for Town Crier & Flowergirl.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "BOTC Tracker"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://botc.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://botc.app/*"],
      "js": ["collector.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["*://botc.app/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
